 "_notes": {
  "method": "答案按『选项原文 → 本站 PDF 选项字母』映射后给出：所有来源先与 资料/e2/pdfs/{year}-2.pdf 的题干/选项逐题比对（完形首句、阅读 Text1 第21题、各题选项文本），确认是同一套英语二试卷后才采用其字母。",
  "paper_check": "7 个 PDF 首页均写明『英语(二) 科目代码 204』，题干首句/Text1 首句与来源页原文一致（如 2013 电子货币、2015 拒绝交流、2021 reskilling、2022 climate-friendly eggs、2023 growth team/假草皮、2024 社交生活/Coyle、2025 小费）。",
  "cross_check": "英语二 21-40 阅读：lazynote 与 guojiya 两个独立题库站逐题完全一致（7 年 140 题全同）；2021 另有中公/新东方、2022 另有新东方、2023 另有新东方逐篇、2024 另有鸿知、2025 另有社科赛斯逐题解析互证。",
  "option_order": "部分来源（人民网/万学海文、中公 2021 新题型、考研教育网/海天 2015 阅读、新东方 2021 新题型）使用的选项排列与本站 PDF 不同；已按选项原文重新映射，字母以本站 PDF 为准，故不计入冲突。",
  "2013_conflict": "2013 跨考版(eol) 答案与本站 PDF 选项顺序下的正确答案在完形 3/5/7/9/12/13/14/16/19/20、阅读 26/28/29/33/34/35/37 上不一致；本站采用 lazynote+guojiya+人民网/中国教育在线解析的答案，已逐题对照 PDF 原文语境复核（如 26『候鸟』= 短暂停留 A、34 = 需充分信息 C、37 = 不情愿的选择 C）。",
  "2015_conflict": "2015 第35题 海天考研 给 C『Companies find it to be fundamental』，原文末段『Everyone makes fun of it, but managers love it, companies depend on it, and regular people willingly absorb it』支持 B『Regular people mock it but accept it』，中公/guojiya/lazynote 亦为 B。",
  "2022_conflict": "2022 第18题 koolearn 给 B(harder)，原句『The older you get, the __ it seems to go』为 quicker=D，中公/lazynote 同；第39题 koolearn 给 D(unrepeatable)，原文『cannot rule out some unknown confounding variable』对应 uncertain=C，guojiya/lazynote 同。",
  "2025_conflict": "2025 第21题 社科赛斯/新东方 给 C『a way of rewarding diligence』，但该表述对应第2段『reward high-quality service』，第1段只说给以小费为主要收入者付小费；四季读书网明确指出 C 属跨段干扰，过级鸭题库 DOM 高亮为 B『was considered essential for waiters』，lazynote 同，故取 B。",
  "2025_neworiental": "新东方在线 2025 英语二整卷答案(1-5 BACDA / 21-25 CBADB / 41-45 CBAED)与本站 PDF 不属同一套题（其完形第1题对应选项 B=discussion，而本站该题答案词为 question=D；其新题型列出的标题 Be a salesman/Use channels/Be humble/Respect the past/Stay positive 在本站 PDF 中依次是 F/C/G/B/A），故仅作冲突记录，不予采用。",
  "socialscience_2025": "社科赛斯 2025 逐题解析中阅读 Text2 区块题号整体前移一位（未编号的【答案】B 实为第26题），已按偏移校正；校正后与 lazynote/guojiya 逐题一致。",
  "coverage": "7 年均取满 45 题（1-20 完形、21-40 阅读、41-45 新题型）；翻译 46 与写作 47-48 无选择题答案，未收录。",
  "not_included": "renrendoc(人人文库) 与 yingyuzhenti 两站同一年份给出的答案互相矛盾且与本站 PDF 语境不符，判定为 AI 生成/拼凑，已弃用。"
 }
